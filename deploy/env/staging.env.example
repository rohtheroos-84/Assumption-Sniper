# Staging — replace placeholders with managed service URLs from your cloud provider
API_ENV=staging
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@staging-db.example.com:5432/assumption_sniper
REDIS_URL=rediss://:PASSWORD@staging-redis.example.com:6379/0
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
JWT_SECRET=${JWT_SECRET}
LOG_JSON=true
METRICS_ENABLED=true
TRACING_ENABLED=true
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.com
