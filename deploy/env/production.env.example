# Production — store real values in GitHub environment secrets / vault, not in git
API_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@prod-db.example.com:5432/assumption_sniper
REDIS_URL=rediss://:PASSWORD@prod-redis.example.com:6379/0
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
JWT_SECRET=${JWT_SECRET}
LOG_JSON=true
METRICS_ENABLED=true
TRACING_ENABLED=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
