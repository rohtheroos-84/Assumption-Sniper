{
  "name": "assumption-sniper",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "test": "pnpm -C apps/web test",
    "lint": "pnpm -C apps/web lint",
    "typecheck": "pnpm -C apps/web typecheck",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "dev:api": "python -m uvicorn app.main:app --reload --app-dir apps/api",
    "lint:api": "python -m ruff check apps/api",
    "format:api": "python -m ruff format apps/api",
    "test:api": "python -m pytest apps/api"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
