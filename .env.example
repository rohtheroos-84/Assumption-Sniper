# api
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assumption_sniper
REDIS_URL=redis://localhost:6379/0
OPENROUTER_API_KEY=change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_PRIMARY_MODEL=openai/gpt-4o-mini
OPENROUTER_REASONING_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=openai/gpt-4.1-mini
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_TOKENS=1200
JWT_SECRET=change-me
RUN_BURST_PER_MINUTE=5
MAX_CONCURRENT_RUNS_PER_USER=2
MAX_QUEUE_DEPTH=50
QUEUE_TASK_MAX_RETRIES=2
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
AI_CACHE_TTL_SECONDS=604800
AI_BATCH_SIZE=8
OPENROUTER_CIRCUIT_FAILURE_THRESHOLD=5
OPENROUTER_CIRCUIT_COOLDOWN_SECONDS=60
SSE_POLL_INTERVAL_SECONDS=1.0
SSE_USE_REDIS_PUBSUB=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# web
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
